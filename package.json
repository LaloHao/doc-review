{
  "name": "doc-review",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted document review: reviewers comment on PDF versions in threads anchored to the text; the owner gets the comments on the web, Telegram, email and in Emacs.",
  "license": "MIT",
  "author": "Eduardo V.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "doc-review": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:emacs": "make test-emacs",
    "dev": "pnpm build && node dist/cli.js serve"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "aws4fetch": "^1.0.20",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
